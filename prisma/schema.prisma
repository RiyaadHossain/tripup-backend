generator client {
  provider     = "prisma-client"
  output       = "../generated/src/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model TeamMember {
  id          String  @id @default(uuid())

  name        String
  designation String
  bio         String?

  profileImg String?

  linkedin String?
  github   String?
  facebook String?

  email String?

  isFeatured  Boolean @default(false)
  isPublished Boolean @default(true)

  displayOrder Int @default(autoincrement())

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([name])
  @@index([isPublished])
}

model Testimonial {
  id          String  @id @default(uuid())

  testimony   String
  userName    String
  userImg     String?
  designation String
  company     String

  isFeatured  Boolean @default(false)
  isPublished Boolean @default(true)

  displayOrder Int @default(autoincrement())

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userName])
  @@index([isPublished])
}

model TravelInsight {
  id              String    @id @default(uuid())

  title           String
  slug            String   @unique
  description     String
  timeReadMin     Int
  author          String
  coverImgUrl     String
  content         String
  insights        String[]
  takeAway        String[]
  seo             Json
  tags            String[]

  isFeatured      Boolean   @default(false)
  isPublished     Boolean   @default(true)

  categoryId      String?
  category        TravelInsightCategory? @relation(fields: [categoryId], references: [id])
  relatedServices Service[]

  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([title])
  @@index([categoryId])
  @@index([isFeatured])
  @@index([isPublished])
}

model Service {
  id             String          @id @default(uuid())
  name           String

  travelInsights TravelInsight[]

  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
}

model TravelInsightCategory {
  id             String          @id @default(uuid())
  name           String

  travelInsights TravelInsight[]

  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
}
