generator client {
  provider     = "prisma-client"
  output       = "../generated/src/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model TeamMember {
  id          String  @id @default(uuid())

  name        String
  designation String
  bio         String?

  profileImg String? 

  linkedin String?
  github   String?
  facebook String?

  email String?

  isFeatured  Boolean @default(false)
  isPublished Boolean @default(true)

  displayOrder Int @default(autoincrement())

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([name])
  @@index([isPublished])
}
