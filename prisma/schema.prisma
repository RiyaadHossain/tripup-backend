generator client {
  provider     = "prisma-client"
  output       = "../generated/src/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum PermissionAction {
  READ
  CREATE
  UPDATE
  DELETE
}

enum ActivityAction {
  LOGIN
  ACCOUNT_CREATED
  CREATE
  UPDATE
  DELETE
  ASSIGN
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
}

enum TaskStatus {
  TO_DO
  IN_PROGRESS
  IN_REVIEW
  DONE
}

// ---------------------------------------------------------------------------
// Auth & RBAC Models
// ---------------------------------------------------------------------------

model User {
  id           String @id @default(uuid())
  name         String
  email        String @unique
  passwordHash String

  needPasswordChange Boolean   @default(false)
  lastLoginAt        DateTime?

  addedById    String?
  addedBy      User?   @relation("UserCreator", fields: [addedById], references: [id])
  createdUsers User[]  @relation("UserCreator")

  addedRoles                   Role[]                  @relation("AddedRole")
  addedTeamMembers             TeamMember[]            @relation("AddedTeamMember")
  addedTestimonials            Testimonial[]           @relation("AddedTestimonial")
  addedTravelInsights          TravelInsight[]         @relation("AddedTravelInsight")
  addedTravelInsightCategories TravelInsightCategory[] @relation("AddedTravelInsightCategory")
  addedTravelServices          TravelService[]         @relation("AddedTravelService")
  addedServiceCategories       ServiceCategory[]       @relation("AddedServiceCategory")
  addedCaseStudies             CaseStudy[]             @relation("AddedCaseStudy")
  addedCaseStudyCategories     CaseStudyCategory[]     @relation("AddedCaseStudyCategory")
  addedPlaybooks               Playbook[]              @relation("AddedPlaybook")
  addedPlaybookTypes           PlaybookType[]          @relation("AddedPlaybookType")
  addedPlaybookCategories      PlaybookCategory[]      @relation("AddedPlaybookCategory")
  addedLeads                   Lead[]                  @relation("AddedLead")
  createdExpenses              Expense[]               @relation("CreatedExpense")
  activities                   UserActivity[]

  // Task Management
  addedDepartments Department[] @relation("AddedDepartment")
  addedMilestones  Milestone[]  @relation("AddedMilestone")
  addedTasks       Task[]       @relation("AddedTask")
  taskAssignments  TaskAssignee[]

  resetPasswordToken   String?
  resetPasswordExpires DateTime?

  roleId String?
  role   Role?   @relation(fields: [roleId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([email])
  @@index([roleId])
}

model Role {
  id          String  @id @default(uuid())
  name        String  @unique
  description String?

  users       User[]
  permissions RolePermission[]

  addedById String?
  addedBy   User?   @relation("AddedRole", fields: [addedById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// A single module+action permission pair (e.g. services.READ).
/// The [module, action] combination is enforced unique so there are
/// no duplicate permissions.
model Permission {
  id     String           @id @default(uuid())
  module String
  action PermissionAction

  roles RolePermission[]

  createdAt DateTime @default(now())

  @@unique([module, action])
  @@index([module])
}

/// Join table between Role and Permission.
/// Uses a composite primary key so each (role, permission) pair is unique.
model RolePermission {
  roleId       String
  permissionId String

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

model TeamMember {
  id String @id @default(uuid())

  name        String
  designation String
  bio         String?

  profileImg String?

  linkedin String?
  github   String?
  facebook String?

  email String?

  isFeatured  Boolean @default(false)
  isPublished Boolean @default(true)

  displayOrder Int @default(autoincrement())

  addedById String?
  addedBy   User?   @relation("AddedTeamMember", fields: [addedById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([name])
  @@index([isPublished])
}

model Testimonial {
  id String @id @default(uuid())

  testimony   String
  userName    String
  userImg     String?
  designation String?
  company     String?

  isFeatured  Boolean @default(false)
  isPublished Boolean @default(true)

  displayOrder Int @default(autoincrement())

  addedById String?
  addedBy   User?   @relation("AddedTestimonial", fields: [addedById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userName])
  @@index([isPublished])
}

model TravelInsight {
  id String @id @default(uuid())

  title       String
  slug        String   @unique
  description String?
  timeReadMin Int
  author      String
  coverImgUrl String
  content     String
  insights    String[]
  takeAway    String[]
  seo         Json?
  tags        String[]

  isFeatured  Boolean @default(false)
  isPublished Boolean @default(true)

  categoryId      String?
  category        TravelInsightCategory? @relation(fields: [categoryId], references: [id])
  relatedServices TravelService[]

  addedById String?
  addedBy   User?   @relation("AddedTravelInsight", fields: [addedById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([title])
  @@index([categoryId])
  @@index([isFeatured])
  @@index([isPublished])
}

model TravelInsightCategory {
  id   String @id @default(uuid())
  name String

  travelInsights TravelInsight[]

  addedById String?
  addedBy   User?   @relation("AddedTravelInsightCategory", fields: [addedById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model TravelService {
  id String @id @default(uuid())

  slug         String  @unique
  title        String
  description  String
  navLinsDesc  String  @default("")
  icon         String?
  category     String?
  comingSoon   Boolean @default(false)
  displayOrder Int     @default(autoincrement())
  isPublished  Boolean @default(true)

  hero         Json
  problem      Json
  capabilities Json
  process      Json
  deliverables Json
  outcomes     Json
  audience     Json
  whyUs        Json
  faq          Json
  cta          Json

  serviceCategoryId String?
  serviceCategory   ServiceCategory? @relation(fields: [serviceCategoryId], references: [id])
  travelInsights    TravelInsight[]

  addedById String?
  addedBy   User?   @relation("AddedTravelService", fields: [addedById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([title])
  @@index([slug])
  @@index([serviceCategoryId])
  @@index([isPublished])
}

model ServiceCategory {
  id   String @id @default(uuid())
  name String @unique

  travelServices TravelService[]

  addedById String?
  addedBy   User?   @relation("AddedServiceCategory", fields: [addedById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model CaseStudy {
  id          String  @id @default(uuid())
  title       String
  excerpt     String?
  readingTime String
  ctaLabel    String @default("View Case Study")
  isFeatured  Boolean @default(false)
  isPublished Boolean @default(true)
  slug        String  @unique
  industryTag String?
  coverImage  String?

  metrics        Json?
  snapshot       Json?
  challenge      Json?
  approachSteps  Json
  deliverables   String[]
  transformation Json?
  results        Json?
  keyTakeaways   String[]
  testimonial    Json?

  categoryId String?
  category   CaseStudyCategory? @relation(fields: [categoryId], references: [id])

  addedById String?
  addedBy   User?   @relation("AddedCaseStudy", fields: [addedById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([title])
  @@index([categoryId])
  @@index([isFeatured])
  @@index([isPublished])
}

model CaseStudyCategory {
  id   String @id @default(uuid())
  name String

  caseStudies CaseStudy[]

  addedById String?
  addedBy   User?   @relation("AddedCaseStudyCategory", fields: [addedById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Playbook {
  id          String  @id @default(uuid())
  title       String
  excerpt     String?
  readingTime String?
  author      String  @default("")
  bestFor     String?
  ctaLabel    String @default("Read Playbook")
  isFeatured  Boolean @default(false)
  isPublished Boolean @default(true)
  slug        String  @unique

  keyTakeaways String[]
  whoIsItFor   String[]
  outcomes     String[]

  frameworkSteps  Json?
  samplePreviews  Json?
  relatedServices Json?

  typeId     String?
  type       PlaybookType?     @relation(fields: [typeId], references: [id])
  categoryId String?
  category   PlaybookCategory? @relation(fields: [categoryId], references: [id])

  addedById String?
  addedBy   User?   @relation("AddedPlaybook", fields: [addedById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([title])
  @@index([typeId])
  @@index([categoryId])
  @@index([isFeatured])
  @@index([isPublished])
}

model PlaybookType {
  id        String     @id @default(uuid())
  name      String     @unique
  playbooks Playbook[]

  addedById String?
  addedBy   User?   @relation("AddedPlaybookType", fields: [addedById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model PlaybookCategory {
  id        String     @id @default(uuid())
  name      String     @unique
  playbooks Playbook[]

  addedById String?
  addedBy   User?   @relation("AddedPlaybookCategory", fields: [addedById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum LeadPriority {
  HIGH
  MEDIUM
  LOW
}

enum LeadStatus {
  NEW
  OLD
  EMAIL_SENT
  DM
  COLD_CALL
  RESPOND
  IGNORED
  CONVERT
}

model Lead {
  id            String       @id @default(uuid())
  businessName  String
  email         String?
  phone         String?
  location      String?
  status        LeadStatus   @default(NEW)
  priority      LeadPriority @default(MEDIUM)
  niche         String?
  facebookLink  String?
  linkedInLink  String?
  instagramLink String?
  twitterLink   String?
  website       String?
  contactPerson String?
  notes         String?
  isPotential   Boolean    @default(false)

  addedById String?
  addedBy   User?   @relation("AddedLead", fields: [addedById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([businessName])
  @@index([status])
}

enum ExpenseStatus {
  PENDING
  DUE
  PAID
}

enum PaymentMethod {
  CASH
  BANK_TRANSFER
  CARD
  MOBILE_BANKING
  OTHER
}

model Expense {
  id            String        @id @default(uuid())
  description   String        @db.VarChar(500)
  category      String        @db.VarChar(255)
  amount        Decimal       @db.Decimal(12, 2)
  currency      String        @default("BDT") @db.VarChar(3)
  status        ExpenseStatus
  expenseDate   DateTime      @db.Date
  paidBy        String?       @db.VarChar(255)
  vendor        String?       @db.VarChar(255)
  vendorContact String?       @db.VarChar(255)
  paymentMethod PaymentMethod?
  reference     String?       @db.VarChar(255)
  attachment    Json?
  notes         String?       @db.Text

  createdById   String?
  createdBy     User?         @relation("CreatedExpense", fields: [createdById], references: [id])

  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([status])
  @@index([category])
  @@index([expenseDate])
  @@map("expenses")
}

// ---------------------------------------------------------------------------
// Task Management
// ---------------------------------------------------------------------------

model Department {
  id          String  @id @default(uuid())
  name        String  @unique
  description String?

  tasks Task[]

  addedById String?
  addedBy   User?   @relation("AddedDepartment", fields: [addedById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([name])
}

model Milestone {
  id          String    @id @default(uuid())
  name        String
  description String?
  dueDate     DateTime?

  tasks Task[]

  addedById String?
  addedBy   User?   @relation("AddedMilestone", fields: [addedById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([name])
}

model Task {
  id          String      @id @default(uuid())
  title       String
  description String?
  deadline    DateTime?
  priority    TaskPriority @default(MEDIUM)
  status      TaskStatus   @default(TO_DO)
  attachment  Json?        // { url, name, size, mimeType }

  // Self-referencing for child/sub-tasks
  parentId String?
  parent   Task?   @relation("TaskChildren", fields: [parentId], references: [id])
  children Task[]  @relation("TaskChildren")

  // Relations
  milestoneId  String?
  milestone    Milestone?  @relation(fields: [milestoneId], references: [id])
  departmentId String?
  department   Department? @relation(fields: [departmentId], references: [id])

  assignees TaskAssignee[]

  addedById String?
  addedBy   User?   @relation("AddedTask", fields: [addedById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([priority])
  @@index([milestoneId])
  @@index([departmentId])
  @@index([parentId])
  @@index([deadline])
}

/// Join table: many-to-many between Task and User (assignees)
model TaskAssignee {
  taskId String
  userId String

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  assignedAt DateTime @default(now())

  @@id([taskId, userId])
  @@index([userId])
}

// ---------------------------------------------------------------------------
// User Activity
// ---------------------------------------------------------------------------

/// Audit log of every significant action performed by a user.
/// objectMeta stores a lightweight snapshot (e.g. { id, name }) so the
/// frontend can render meaningful messages without extra DB lookups.
model UserActivity {
  id         String         @id @default(uuid())
  action     ActivityAction
  module     String         // e.g. "leads", "case_studies", "travel_services"
  objectId   String?        // ID of the affected resource
  objectMeta Json?          // Lightweight snapshot: { id, name } for display

  userId String?
  user   User?  @relation(fields: [userId], references: [id])

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([module])
  @@index([createdAt])
}
