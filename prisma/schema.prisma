generator client {
  provider     = "prisma-client"
  output       = "../generated/src/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum PermissionAction {
  READ
  CREATE
  UPDATE
  DELETE
}

// ---------------------------------------------------------------------------
// Auth & RBAC Models
// ---------------------------------------------------------------------------

model User {
  id           String @id @default(uuid())
  name         String
  email        String @unique
  passwordHash String

  needPasswordChange Boolean   @default(false)
  lastLoginAt        DateTime?

  addedById    String?
  addedBy      User?   @relation("UserCreator", fields: [addedById], references: [id])
  createdUsers User[]  @relation("UserCreator")

  addedRoles                   Role[]                  @relation("AddedRole")
  addedTeamMembers             TeamMember[]            @relation("AddedTeamMember")
  addedTestimonials            Testimonial[]           @relation("AddedTestimonial")
  addedTravelInsights          TravelInsight[]         @relation("AddedTravelInsight")
  addedTravelInsightCategories TravelInsightCategory[] @relation("AddedTravelInsightCategory")
  addedTravelServices          TravelService[]         @relation("AddedTravelService")
  addedServiceCategories       ServiceCategory[]       @relation("AddedServiceCategory")
  addedCaseStudies             CaseStudy[]             @relation("AddedCaseStudy")
  addedCaseStudyCategories     CaseStudyCategory[]     @relation("AddedCaseStudyCategory")
  addedPlaybooks               Playbook[]              @relation("AddedPlaybook")
  addedPlaybookTypes           PlaybookType[]          @relation("AddedPlaybookType")
  addedPlaybookCategories      PlaybookCategory[]      @relation("AddedPlaybookCategory")

  resetPasswordToken   String?
  resetPasswordExpires DateTime?

  roleId String?
  role   Role?   @relation(fields: [roleId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([email])
  @@index([roleId])
}

model Role {
  id          String  @id @default(uuid())
  name        String  @unique
  description String?

  users       User[]
  permissions RolePermission[]

  addedById String?
  addedBy   User?   @relation("AddedRole", fields: [addedById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// A single module+action permission pair (e.g. services.READ).
/// The [module, action] combination is enforced unique so there are
/// no duplicate permissions.
model Permission {
  id     String           @id @default(uuid())
  module String
  action PermissionAction

  roles RolePermission[]

  createdAt DateTime @default(now())

  @@unique([module, action])
  @@index([module])
}

/// Join table between Role and Permission.
/// Uses a composite primary key so each (role, permission) pair is unique.
model RolePermission {
  roleId       String
  permissionId String

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

model TeamMember {
  id String @id @default(uuid())

  name        String
  designation String
  bio         String?

  profileImg String?

  linkedin String?
  github   String?
  facebook String?

  email String?

  isFeatured  Boolean @default(false)
  isPublished Boolean @default(true)

  displayOrder Int @default(autoincrement())

  addedById String?
  addedBy   User?   @relation("AddedTeamMember", fields: [addedById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([name])
  @@index([isPublished])
}

model Testimonial {
  id String @id @default(uuid())

  testimony   String
  userName    String
  userImg     String?
  designation String
  company     String

  isFeatured  Boolean @default(false)
  isPublished Boolean @default(true)

  displayOrder Int @default(autoincrement())

  addedById String?
  addedBy   User?   @relation("AddedTestimonial", fields: [addedById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userName])
  @@index([isPublished])
}

model TravelInsight {
  id String @id @default(uuid())

  title       String
  slug        String   @unique
  description String
  timeReadMin Int
  author      String
  coverImgUrl String
  content     String
  insights    String[]
  takeAway    String[]
  seo         Json?
  tags        String[]

  isFeatured  Boolean @default(false)
  isPublished Boolean @default(true)

  categoryId      String?
  category        TravelInsightCategory? @relation(fields: [categoryId], references: [id])
  relatedServices TravelService[]

  addedById String?
  addedBy   User?   @relation("AddedTravelInsight", fields: [addedById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([title])
  @@index([categoryId])
  @@index([isFeatured])
  @@index([isPublished])
}

model TravelInsightCategory {
  id   String @id @default(uuid())
  name String

  travelInsights TravelInsight[]

  addedById String?
  addedBy   User?   @relation("AddedTravelInsightCategory", fields: [addedById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model TravelService {
  id String @id @default(uuid())

  slug         String  @unique
  title        String
  description  String
  navLinsDesc  String  @default("")
  icon         String?
  category     String?
  comingSoon   Boolean @default(false)
  displayOrder Int     @default(autoincrement())
  isPublished  Boolean @default(true)

  hero         Json
  problem      Json
  capabilities Json
  process      Json
  deliverables Json
  outcomes     Json
  audience     Json
  whyUs        Json
  faq          Json
  cta          Json

  serviceCategoryId String?
  serviceCategory   ServiceCategory? @relation(fields: [serviceCategoryId], references: [id])
  travelInsights    TravelInsight[]

  addedById String?
  addedBy   User?   @relation("AddedTravelService", fields: [addedById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([title])
  @@index([slug])
  @@index([serviceCategoryId])
  @@index([isPublished])
}

model ServiceCategory {
  id   String @id @default(uuid())
  name String @unique

  travelServices TravelService[]

  addedById String?
  addedBy   User?   @relation("AddedServiceCategory", fields: [addedById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model CaseStudy {
  id          String  @id @default(uuid())
  title       String
  excerpt     String
  date        String
  readingTime String
  ctaLabel    String
  isFeatured  Boolean @default(false)
  isPublished Boolean @default(true)
  slug        String  @unique
  industryTag String
  coverImage  String

  metrics        Json
  snapshot       Json
  challenge      Json
  approachSteps  Json
  deliverables   String[]
  transformation Json
  results        Json
  keyTakeaways   String[]
  testimonial    Json

  categoryId String?
  category   CaseStudyCategory? @relation(fields: [categoryId], references: [id])

  addedById String?
  addedBy   User?   @relation("AddedCaseStudy", fields: [addedById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([title])
  @@index([categoryId])
  @@index([isFeatured])
  @@index([isPublished])
}

model CaseStudyCategory {
  id   String @id @default(uuid())
  name String

  caseStudies CaseStudy[]

  addedById String?
  addedBy   User?   @relation("AddedCaseStudyCategory", fields: [addedById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Playbook {
  id          String  @id @default(uuid())
  title       String
  excerpt     String
  date        String
  readingTime String
  author      String  @default("")
  bestFor     String
  ctaLabel    String
  isFeatured  Boolean @default(false)
  isPublished Boolean @default(true)
  slug        String  @unique

  keyTakeaways String[]
  whoIsItFor   String[]
  outcomes     String[]

  frameworkSteps  Json
  samplePreviews  Json
  relatedServices Json

  typeId     String?
  type       PlaybookType?     @relation(fields: [typeId], references: [id])
  categoryId String?
  category   PlaybookCategory? @relation(fields: [categoryId], references: [id])

  addedById String?
  addedBy   User?   @relation("AddedPlaybook", fields: [addedById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([title])
  @@index([typeId])
  @@index([categoryId])
  @@index([isFeatured])
  @@index([isPublished])
}

model PlaybookType {
  id        String     @id @default(uuid())
  name      String     @unique
  playbooks Playbook[]

  addedById String?
  addedBy   User?   @relation("AddedPlaybookType", fields: [addedById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model PlaybookCategory {
  id        String     @id @default(uuid())
  name      String     @unique
  playbooks Playbook[]

  addedById String?
  addedBy   User?   @relation("AddedPlaybookCategory", fields: [addedById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
